<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tschanz.v_bro</groupId>
        <artifactId>v-bro-parent</artifactId>
        <relativePath>../pom.xml</relativePath>
        <version>0.0.1</version>
    </parent>

    <artifactId>v-bro-app</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-app-presentation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-app-presentation-jfx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-app-usecase</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-data-structure-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-data-structure-persistence-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-data-structure-persistence-mock</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-data-structure-persistence-xml</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-repo-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-repo-persistence-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-repo-persistence-mock</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tschanz.v_bro</groupId>
            <artifactId>v-bro-repo-persistence-xml</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <groupId>org.apache.maven.plugins</groupId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.tschanz.v_bro.app.Main</mainClass>
                                </transformer>
                            </transformers>
                            <finalName>${project.artifactId}-${project.version}-jar-with-dependencies</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Launch4j: wraps the shaded JAR into a Windows EXE -->
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.5.1</version>
                <executions>
                    <execution>
                        <id>create-exe</id>
                        <!-- runs after 'package' has produced the shaded fat JAR -->
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <!-- Path to the fat JAR produced by maven-shade-plugin -->
                            <jar>${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</jar>
                            <!-- Output EXE -->
                            <outfile>${project.build.directory}/${project.artifactId}-${project.version}.exe</outfile>
                            <!-- Icon for the EXE (must be .ico format) -->
                            <icon>${project.basedir}/src/main/resources/v-bro.ico</icon>
                            <!-- JavaFX GUI app: no console window -->
                            <headerType>gui</headerType>
                            <!-- No <classPath> here: Launch4j will use "java -jar" mode -->
                            <jre>
                                <!-- Minimum Java version required on the end-user's machine -->
                                <minVersion>11</minVersion>
                            </jre>
                            <!-- Splash screen shown while the JVM starts up (must be .bmp format) -->
                            <splash>
                                <file>${project.basedir}/src/main/resources/v-bro-splash.bmp</file>
                                <waitForWindow>true</waitForWindow>
                                <timeout>60</timeout>
                                <timeoutErr>true</timeoutErr>
                            </splash>
                            <versionInfo>
                                <fileVersion>0.0.1.0</fileVersion>
                                <txtFileVersion>${project.version}</txtFileVersion>
                                <fileDescription>v-bro</fileDescription>
                                <copyright>tschanz</copyright>
                                <productVersion>0.0.1.0</productVersion>
                                <txtProductVersion>${project.version}</txtProductVersion>
                                <productName>v-bro</productName>
                                <internalName>${project.artifactId}</internalName>
                                <originalFilename>${project.artifactId}-${project.version}.exe</originalFilename>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>